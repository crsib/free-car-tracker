        "viewName": "cost_view",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT vehicleId, dateMillis, totalCostMinor, 'FUEL' AS sourceType, NULL AS category\n        FROM fuel_entries\n        UNION ALL\n        SELECT vehicleId, dateMillis, totalCostMinor, 'CHARGE' AS sourceType, NULL AS category\n        FROM charge_entries\n        UNION ALL\n        SELECT vehicleId, dateMillis, totalCostMinor, 'EXPENSE' AS sourceType, category AS category\n        FROM expenses"
      }
